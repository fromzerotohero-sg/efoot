# Dormant by default. Do not point production traffic here.
BACKEND_MODE=dormant
PORT=4050
HOST=127.0.0.1

# Explicit lock: even if BACKEND_MODE is changed, live stays off unless this is 1.
ALLOW_BACKEND_LIVE=0

# Same Supabase as the Next app. Dormant mode must not write.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Explicitly opt in to authenticated RLS-protected SELECTs only.
ALLOW_DORMANT_DB_READS=0

# User-owned operations use caller JWT where RLS is the owner.
# Server-owned operations use service role only after identity resolution and
# must still add user_id filters. It remains blocked while dormant.
# SUPABASE_SERVICE_ROLE_KEY=

# Loaded only after live cutover is approved.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.2

# Never set MetalGate keys on this process in dormant mode.
# METALGATE_API_KEY=
