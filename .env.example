# Gattilio27 Environment Variables
# Copy this file to .env.local and fill in the values

# ===== SUPABASE CONFIGURATION =====
# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Public Key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (keep secret, server-side only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ===== OPENAI (server-side only, never expose in frontend) =====
# Obbligatorio: senza questa chiave la chat assistente ritorna OPENAI_KEY_MISSING e non chiama OpenAI.
OPENAI_API_KEY=your_openai_api_key_here
# Modello (opzionale). Default in codice: gpt-5.2. Alias gpt-5 deprecato da OpenAI.
# In locale: imposta qui o lascia vuoto per usare gpt-5.2. Su Vercel: imposta in Environment Variables.
# OPENAI_MODEL=gpt-5.2

# ===== VERCEL CONFIGURATION =====
# Environment type
VERCEL_ENV=development

# Vercel URL (auto-set in production)
VERCEL_URL=http://localhost:3000

# ===== CREDITI / HERO POINTS =====
# Crediti di default per utente.
# POLICY: nessun credito omaggio (default = 0). Per test puoi impostare un valore (es. 10000).
# CREDITS_INCLUDED_DEFAULT=10000

# Chiave segreta per API accredito (sito pagamenti). Solo quando il sito pagamenti è collegato.
# CREDITS_ACCREDIT_API_KEY=your_shared_secret_here

# ===== METALGATE INTEGRATION =====
# URL per API MetalGate (Store/Credits)
# NEXT_PUBLIC_METALGATE_API_URL=https://your-metalgate-url.com/api
# API Key per chiamate server-to-server verso MetalGate
# METALGATE_API_KEY=your_metalgate_internal_api_key

# ===== APPLICATION CONFIGURATION =====
# URL pubblico dell'app (link nelle email: conferma iscrizione, recupero password). In produzione imposta il tuo dominio.
# NEXT_PUBLIC_APP_URL=https://tuodominio.com

# Application name
NEXT_PUBLIC_APP_NAME=Gattilio27

# Node environment
NODE_ENV=development

# ===== MAINTENANCE MODE =====
# Attiva la pagina di blocco e nasconde dashboard/app a tutti tranne chi ha la chiave team.
# MAINTENANCE_MODE=true
# Chiave segreta per bypass manutenzione (solo team interno).
# MAINTENANCE_BYPASS_KEY=your_secret_team_key
